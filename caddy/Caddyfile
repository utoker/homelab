# /etc/caddy/Caddyfile
#
# Reverse proxy for airmon, the Pi-hosted app. Certs auto-fetched from
# Let's Encrypt via HTTP-01 (requires port 80 open at the router).
# Plus a LAN-only plain-HTTP listener on :8081 for the purifier ESP32s.

{
    # global options
    email umut@utoker.com
}

airmon.utoker.com {
    # The public site is read-only. The Pi agent writes to 127.0.0.1:8000
    # directly, and readings drive the purifier fans, so a write through here
    # could only be someone faking air quality. GET/HEAD and the SPA pass.
    @api_write {
        path /api /api/*
        not method GET HEAD
    }
    respond @api_write 404

    reverse_proxy 127.0.0.1:8000

    encode gzip zstd

    log {
        output file /var/log/caddy/airmon.utoker.com.log {
            roll_size 10MiB
            roll_keep 7
        }
    }
}

# Purifier ESP32s poll airmon's target-duty endpoint here over plain HTTP, so
# fan control needs neither TLS nor internet. Only GET /api/purifier/* from
# the LAN is proxied; everything else is a 404. ufw also limits 8081 to the
# LAN (bootstrap-pi.sh); this matcher is the second lock.
http://:8081 {
    @purifier {
        method GET
        path /api/purifier/*
        remote_ip 192.168.1.0/24
    }

    handle @purifier {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        respond 404
    }

    log {
        output file /var/log/caddy/airmon-purifier-lan.log {
            roll_size 10MiB
            roll_keep 7
        }
    }
}
